{
  "multipart": [
    {
      "apply": {
        "model": "powergrid:block/fuse_holder_h",
        "x": 180,
        "y": -90
      },
      "when": {
        "axis_along_first": "true",
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "powergrid:block/fuse_holder_h",
        "x": 90,
        "y": -90
      },
      "when": {
        "axis_along_first": "false",
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "powergrid:block/fuse",
        "x": -90
      },
      "when": {
        "facing": "north",
        "state": "closed"
      }
    },
    {
      "apply": {
        "model": "powergrid:block/fuse_blown",
        "x": -90
      },
      "when": {
        "facing": "north",
        "state": "blown"
      }
    },
    {
      "apply": {
        "model": "powergrid:block/fuse_holder_h",
        "x": 180
      },
      "when": {
        "axis_along_first": "true",
        "facing": "east"
